<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DNS servers of the active network, for the guest's resolv.conf. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Setup runs as a foreground service with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- A running Flatpak session (display, audio, the app) stays in the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A Flatpak allowed to use the microphone records through Android's, while it records. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The shared home (Documents/Flatdroid) by path: Android 10 and older need this for it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Only through the user's All files access setting (Settings > Storage): every file in the
         shared home becomes visible, and an app's /sdcard setting becomes available. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Whether a VNC viewer is installed, to open the session's display. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vnc" />
        </intent>
    </queries>

    <application
        android:name=".FlatdroidApplication"
        android:allowBackup="@bool/allow_backup"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flatdroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Flatdroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".setup.SetupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".flatpak.FlatpakTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Linux desktop app (Flatpak) under proot with its X11 display server and audio server, while the user views it in a VNC viewer." />
        </service>

        <service
            android:name=".storage.StorageTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Private homes in the Files app. MANAGE_DOCUMENTS: only Android's own Files app and
             picker can browse it; other apps get only what the user picks. -->
        <provider
            android:name=".storage.HomesProvider"
            android:authorities="com.garathon.flatdroid.homes"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>