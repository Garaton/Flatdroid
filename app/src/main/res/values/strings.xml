    <string name="app_settings_microphone">Microphone</string>
    <string name="app_settings_microphone_hint">Off: the app records silence. On: the first time the app records, a notification asks to allow or deny it until the app is closed. Android\'s microphone is used only while the app records. Needs sound on.</string>
    <string name="app_settings_always_allow_microphone">Always allow microphone</string>
    <string name="app_settings_always_allow_microphone_hint">Uses Android\'s microphone whenever the app records, without asking. Needs the microphone on.</string>
    <string name="app_settings_microphone_android_denied">Android didn\'t allow Flatdroid to use the microphone.</string>
    <string name="app_settings_devices">Devices</string>
    <string name="app_settings_whole_dev">All of /dev</string>
    <string name="app_settings_whole_dev_hint">This app asks for all devices. Normally it gets graphics, input, KVM and USB devices where the phone has them. With this on it gets every device node, including Android\'s Binder, through which it can call Android\'s system services as Flatdroid.</string>
