    <string name="settings_section_viewer">VNC viewer</string>
    <string name="settings_viewer">Default viewer</string>
    <string name="settings_viewer_hint">Determines what the default VNC Viewer app is. With \"Ask every time\", Android asks which app to use each time.</string>
    <string name="settings_viewer_ask">Ask every time</string>
    <string name="settings_viewer_missing">%1$s (not installed)</string>
    <string name="settings_frame_rate_60">60 FPS mode</string>
    <string name="settings_frame_rate_60_hint">Changes away from the default 30 FPS, significantly increases CPU usage and reduces battery life. Applies next launch.</string>
    <string name="settings_custom_frame_rate">Frame rate</string>
    <string name="settings_custom_frame_rate_hint">%1$d to %2$d; overrides any other FPS setting. Clear this field to go back to 30/60 FPS.</string>
    <string name="settings_uncapped_frame_rate">Uncapped frame rate</string>
    <string name="settings_uncapped_frame_rate_hint">As many frames as Xvnc can send.</string>
    <string name="settings_title_bars">Window title bars</string>
    <string name="settings_title_bars_hint">Title bars with close and maximize buttons on app windows. Without them apps get more room, but some (GTK3, Qt) can then only be closed from their own menus. Applies next launch.</string>
    <string name="settings_gpu_runtimes">Install GPU runtimes</string>
    <string name="settings_gpu_runtimes_hint">Lets Flatpak install vendor GPU and video decoding runtimes (NVIDIA, VAAPI) with apps. Flatdroid renders in software and doesn\'t use them; off saves space, and saving with it off removes ones already installed.</string>
    <string name="developer_setting">Developer setting</string>
    <string name="settings_section_audio">Audio</string>
    <string name="settings_low_latency_audio">Low latency audio</string>
    <string name="settings_low_latency_audio_hint">Plays sound through Android\'s low latency output instead of its power saving one. Gives less delay and fewer crackles, significantly increases CPU usage and reduces battery life. Applies next launch.</string>
    <string name="settings_high_quality_audio">High quality audio</string>
    <string name="settings_high_quality_audio_hint">Converts sound from apps whose sample rate differs from the phone\'s at a higher quality, slightly increases CPU usage. Applies next launch.</string>
    <string name="settings_audio_latency">Audio latency (ms)</string>
    <string name="settings_audio_latency_hint">%1$d to %2$d; clear the field for the default %3$d ms. Lower is more responsive but can crackle. Applies next launch.</string>
    <string name="settings_section_developer">Developer</string>
    <string name="settings_developer_options">Developer options</string>
    <string name="settings_developer_options_hint">Shows extra settings that Flatdroid either manages itself, or are dangerous/unfriendly for the average user.</string>

