    <string name="reset_text">Alpine is deleted and set up again from scratch: downloaded again, and its packages reinstalled.</string>
    <string name="reset_keep">Keep installed Flatpaks</string>
    <string name="reset_remove">Remove Flatpaks, keep app data and caches</string>
    <string name="reset_wipe">Wipe everything</string>
    <string name="reset_keep_hint">Flatpaks and all associated data (settings, cache, homes, etc), stay downloaded within Flatdroid to be used again after the environment is reset.</string>
    <string name="reset_remove_hint">Flatpaks and all runtimes are removed, however their associated data (settings, cache, home, etc) stay can </string>
    <string name="reset_wipe_hint">Everything in Flatdroid is wiped (Alpine, Flatpak apps and data), and you start from a clean slate. The only thing that remains the same is Flatdroid\'s own global settings.</string>
