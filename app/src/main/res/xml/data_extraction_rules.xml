<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12 and newer; same exclusion as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="alpine" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="alpine" />
    </device-transfer>
</data-extraction-rules>
