<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer; same contents as backup_rules.xml. Cloud backup only runs when it is
     end-to-end encrypted. Device-to-device transfer goes directly to the new device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="appdata" />
        <include domain="file" path="settings.properties" />
        <include domain="file" path="appsettings" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="appdata" />
        <include domain="file" path="settings.properties" />
        <include domain="file" path="appsettings" />
    </device-transfer>
</data-extraction-rules>
