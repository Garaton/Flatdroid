<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash screen stays white in dark mode too, behind the icon; the window after it
         follows the theme. -->
    <style name="Theme.Flatdroid" parent="Base.Flatdroid">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
    </style>
    <!-- A shortcut's cover (LaunchActivity): a plain splash in the window's own colour, no icon,
         so the cover follows it unseen. -->
    <style name="Theme.Flatdroid.Launch" parent="Theme.Flatdroid">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
