diff --git a/src/tracee/seccomp.c b/src/tracee/seccomp.c
index 0f9afa0..2143382 100644
--- a/src/tracee/seccomp.c
+++ b/src/tracee/seccomp.c
@@ -529,6 +529,18 @@ static int handle_seccomp_event_common(Tracee *tracee)
 		restart_syscall_after_seccomp(tracee);
 		break;
 
+	case PR_readlink:
+		/* Android 8's x86_64 app seccomp policy blocks readlink(2)
+		 * (bionic only uses readlinkat), and musl and glibc both call
+		 * it on x86_64: re-issue it as readlinkat(AT_FDCWD, ...).  */
+		set_sysnum(tracee, PR_readlinkat);
+		poke_reg(tracee, SYSARG_4, peek_reg(tracee, CURRENT, SYSARG_3));
+		poke_reg(tracee, SYSARG_3, peek_reg(tracee, CURRENT, SYSARG_2));
+		poke_reg(tracee, SYSARG_2, peek_reg(tracee, CURRENT, SYSARG_1));
+		poke_reg(tracee, SYSARG_1, AT_FDCWD);
+		restart_syscall_after_seccomp(tracee);
+		break;
+
 	case PR_mkdir:
 		set_sysnum(tracee, PR_mkdirat);
 		poke_reg(tracee, SYSARG_3, peek_reg(tracee, CURRENT, SYSARG_2));
