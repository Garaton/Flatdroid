+	case PR_faccessat2:
+	{
+		/* Android's app seccomp policy blocks faccessat2(2) before
+		 * Android 16.  On ENOSYS glibc emulates AT_EACCESS and
+		 * AT_SYMLINK_NOFOLLOW itself, but musl only falls back for
+		 * AT_EACCESS and fails with EINVAL for AT_SYMLINK_NOFOLLOW,
+		 * which GLib reads as "file missing".  Re-issue it as
+		 * faccessat(dirfd, path, mode).  Exact for no flags and
+		 * AT_EACCESS (tracees' real and effective IDs are the same);
+		 * with AT_SYMLINK_NOFOLLOW the only difference is a dangling
+		 * symlink, which is reported as missing.  Other flags
+		 * (AT_EMPTY_PATH) keep failing with ENOSYS.  */
+		word_t flags = peek_reg(tracee, CURRENT, SYSARG_4);
+		if ((flags & ~(AT_EACCESS | AT_SYMLINK_NOFOLLOW)) != 0) {
+			set_result_after_seccomp(tracee, -ENOSYS);
+			break;
+		}
+		set_sysnum(tracee, PR_faccessat);
+		poke_reg(tracee, SYSARG_4, 0);
+		restart_syscall_after_seccomp(tracee);
+		break;
+	}
+
