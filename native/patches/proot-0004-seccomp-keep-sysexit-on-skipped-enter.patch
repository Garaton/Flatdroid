+				 * PTRACE_CONT, the sysexit stop is lost and the
+				 * next PTRACE_EVENT_SECCOMP stop finds the tracee
+				 * "in sysexit".  The skipping below restarts it
+				 * with PTRACE_SYSCALL.  */
+				if (tracee->seccomp_already_handled_enter)
+					;
+				else if (IS_IN_SYSENTER(tracee)) {
 					/* sysenter: ensure the sysexit
 					 * stage will be hit under seccomp.  */
 					tracee->restart_how = PTRACE_SYSCALL;
